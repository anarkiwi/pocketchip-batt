#!/bin/bash



battery.sh | grep CHARG_IND | grep -o '.$' > /usr/lib/pocketchip-batt/charging

NEW_V=$(battery.sh | grep "Battery voltage" | awk '{printf $4}' | sed 's/..$//')
OLD_V=$(cat /usr/lib/pocketchip-batt/voltage)

if [[ -z "$NEW_V" ]] && [[ -z "$OLD_V" ]]; then
  NEW_V=3700
  OLD_V=3700
fi

if [[ -z "$NEW_V" ]]; then
  NEW_V=3700
fi

if [[ -z "$OLD_V" ]]; then
  OLD_V=3700
fi

# Never leave voltage empty: if bc fails/produces nothing, the warn pollers would
# otherwise read an empty value. Write to a temp + validate, then move into place
# (also avoids the truncate-then-write window the warn readers could catch).
AVG_V=$(echo "($NEW_V + $OLD_V) / 2" | bc 2>/dev/null)
[ -z "$AVG_V" ] && AVG_V="$OLD_V"
printf '%s\n' "$AVG_V" > /usr/lib/pocketchip-batt/voltage.tmp \
  && mv -f /usr/lib/pocketchip-batt/voltage.tmp /usr/lib/pocketchip-batt/voltage
