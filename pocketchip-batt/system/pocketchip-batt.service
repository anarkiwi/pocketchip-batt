[Unit]
Description=PocketCHIP battery state for pocket-home and the battery warnings
ConditionFileIsExecutable=/usr/sbin/pocketchip-batt

[Service]
Type=simple
ExecStart=/usr/sbin/pocketchip-batt
Restart=on-failure
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_NETLINK
RuntimeDirectory=pocketchip-batt
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=multi-user.target
